# Temporary HTML caches. Full copies of websites do not belong in Git.
# Scoped to data/raw deliberately: a bare *.html would also swallow
# frontend/template.html and the generated docs/index.html, which are both
# source of the deliverable and must be tracked.
data/raw/
data/raw/**/*.html
data/raw/**/*.html.gz

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# macOS
.DS_Store

# Excel lock files
~$*.xlsx
